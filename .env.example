# acme-lan configuration. Copy to .env and edit. All vars use the ACME_LAN_ prefix.

# --- Downstream ACME server (what your internal clients connect to) ---
# The base URL your clients use to reach this server. Must match how they address it
# (used to build every directory/resource URL).
ACME_LAN_EXTERNAL_URL=http://acme-lan.lan:8000

# SQLite by default. The parent directory is created automatically.
ACME_LAN_DATABASE_URL=sqlite+aiosqlite:///./data/acme_lan.db

# http-01 downstream validation timeout (seconds).
ACME_LAN_HTTP01_TIMEOUT=10

# Optional: override where the validator connects for a given identifier, as JSON
# (identifier -> "host[:port]"). Useful for split-horizon quirks / testing.
# ACME_LAN_HTTP01_RESOLVER_OVERRIDES={"db.example.net": "192.168.3.5"}

# --- Upstream ACME CA (the real public CA we proxy to) ---
# Let's Encrypt staging by default. Switch to production once verified:
#   https://acme-v02.api.letsencrypt.org/directory
ACME_LAN_UPSTREAM_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_LAN_UPSTREAM_ACCOUNT_EMAIL=you@example.com
ACME_LAN_UPSTREAM_VERIFY_SSL=true
ACME_LAN_UPSTREAM_ACCOUNT_KEY_PATH=./data/upstream_account.key
ACME_LAN_UPSTREAM_FINALIZE_TIMEOUT=90

# How we prove control to the upstream CA: dns-01 (default) or http-01 (edge).
ACME_LAN_UPSTREAM_CHALLENGE=dns-01
# For upstream http-01: the edge responder port (must be reachable by the upstream) and,
# optionally, the public IP identifiers should resolve to (only used by A-capable providers).
ACME_LAN_EDGE_HTTP_PORT=80
ACME_LAN_EDGE_PUBLIC_IP=

# --- DNS provider used for the upstream DNS-01 challenge ---
# cloudflare | acmedns | challtestsrv
ACME_LAN_DNS_PROVIDER=cloudflare
# Seconds to wait after publishing TXT before answering (0 is fine for most providers).
ACME_LAN_DNS_PROPAGATION_SECONDS=0

# Cloudflare: API token scoped to Zone.DNS:Edit for your zone(s).
ACME_LAN_CLOUDFLARE_API_TOKEN=

# acme-dns: delegate _acme-challenge via CNAME to an acme-dns instance.
ACME_LAN_ACMEDNS_API_URL=
ACME_LAN_ACMEDNS_USERNAME=
ACME_LAN_ACMEDNS_PASSWORD=
ACME_LAN_ACMEDNS_SUBDOMAIN=

# challtestsrv (tests only): management API of pebble-challtestsrv.
ACME_LAN_CHALLTESTSRV_URL=http://localhost:8055

# --- Web dashboard / management API ---
# If set, the management API + dashboard require this bearer token (ACME endpoints never do).
ACME_LAN_ADMIN_TOKEN=
ACME_LAN_HEALTH_DEFAULT_PORT=443

# --- Managed hosts / device push ---
# Fernet key for encrypting stored device credentials + locally-stored private keys.
ACME_LAN_SECRET_KEY=

# --- Certificate / key storage backend: local | azure_keyvault | vault ---
ACME_LAN_CERT_STORE_BACKEND=local
# Azure Key Vault (install extras: pip install .[storage]); uses DefaultAzureCredential.
ACME_LAN_AZURE_KEYVAULT_URL=
# HashiCorp Vault (KV v2).
ACME_LAN_VAULT_URL=
ACME_LAN_VAULT_TOKEN=
ACME_LAN_VAULT_MOUNT=secret
ACME_LAN_VAULT_PATH_PREFIX=acme-lan

# --- Expiry notifications ---
ACME_LAN_EXPIRY_WARN_DAYS=21
ACME_LAN_POSTMARK_SERVER_TOKEN=
ACME_LAN_NOTIFY_EMAIL_FROM=
ACME_LAN_NOTIFY_EMAIL_TO=
ACME_LAN_NOTIFY_WEBHOOK_URL=

# --- Self TLS certificate (serve acme-lan itself over trusted HTTPS) ---
# Set the hostname acme-lan is reached on and enable to auto-obtain/renew its own cert.
# Requires ACME_LAN_SECRET_KEY: the key is stored encrypted and only the public cert is
# written to ACME_LAN_SELF_CERT_PATH (see docs/SECURITY.md).
ACME_LAN_SERVICE_DOMAIN=
ACME_LAN_SELF_CERT_ENABLED=false
ACME_LAN_SELF_CERT_PATH=./data/service_cert.pem

# --- Auto-renew scheduler ---
ACME_LAN_RENEW_BEFORE_DAYS=30
ACME_LAN_AUTO_RENEW_ENABLED=false
ACME_LAN_RENEW_CHECK_INTERVAL_SECONDS=3600
